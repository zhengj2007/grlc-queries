#+ endpoint: https://sparql.hegroup.org/sparql?format=text/csv
#+ summary: Find Brucella vaccines with definition sources

PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX obo: <http://purl.obolibrary.org/obo/>

SELECT ?vaccine_id 
       ?vaccine_label
       (GROUP_CONCAT(DISTINCT ?disease; separator="|") AS ?diseases)
       (GROUP_CONCAT(DISTINCT ?pathogen; separator="|") AS ?pathogens)
       (GROUP_CONCAT(DISTINCT ?recipient; separator="|") AS ?recipients)
       (GROUP_CONCAT(DISTINCT ?animal_model; separator="|") AS ?animal_models)
       (GROUP_CONCAT(DISTINCT ?role; separator="|") AS ?roles)
       (GROUP_CONCAT(DISTINCT ?def_source; separator="|") AS ?def_sources)
FROM <http://purl.obolibrary.org/obo/merged/VO>
WHERE {
    # Hierarchy: Brucella vaccine and its subclasses
    ?vaccine_iri rdfs:subClassOf* obo:VO_0000025 .
    
    # Retrieve label and cast to string
    ?vaccine_iri rdfs:label ?label_val .
    BIND(STR(?label_val) AS ?vaccine_label)
    
    # Format the ID (VO_0000723 -> VO:0000723)
    BIND(REPLACE(STRAFTER(STR(?vaccine_iri), "obo/"), "_", ":") AS ?vaccine_id)

    # Object Properties

    # Mapping 'immunizes against disease' (VO_0001011)
    OPTIONAL {
        ?vaccine_iri rdfs:subClassOf [
            owl:onProperty obo:VO_0001011 ;
            owl:someValuesFrom ?disease
        ] .
    }
    # Mapping 'immunizes against pathogen' (VO_0003355)
    OPTIONAL {
        ?vaccine_iri rdfs:subClassOf [
            owl:onProperty obo:VO_0003355 ;
            owl:someValuesFrom ?pathogen
        ] .
    }
    # Mapping 'test in lab animal model' (VO_0003390)
    OPTIONAL {
        ?vaccine_iri rdfs:subClassOf [
            owl:onProperty obo:VO_0003390 ;
            owl:someValuesFrom ?animal_model
        ] .
    }
    # Mapping 'has role' (RO_0000087)
    OPTIONAL {
        ?vaccine_iri rdfs:subClassOf [
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom ?role
        ] .
    }
    # Mapping 'immunizes recipient' (VO_0001243)
    OPTIONAL {
        ?vaccine_iri rdfs:subClassOf [
            owl:onProperty obo:VO_0001243 ;
            owl:someValuesFrom ?recipient
        ] .
    }

    OPTIONAL { ?vaccine_iri obo:IAO_0000119 ?def_source . }
}
GROUP BY ?vaccine_id ?vaccine_label